---
// Playable Editorial Desk v0.2 — EXPERIMENT
//
// Three real-semantic, physical objects sit beside the Current Question as
// extra, playful entries. They are enhancement, NOT navigation dependency:
// every object's content is also reachable through the normal text nav
// (Explore / the links below each object).
//
// Verbs are distinct but the objects belong to one physical world:
//   Newspaper  → UNFOLD   (READ  · Essays & research → /explore/)
//   Envelope   → OPEN     (DO    · Practical guides → honest IN PROGRESS)
//   Clapperboard → CLAP   (WATCH · Video & scripts   → honest IN PROGRESS)
//
// Honesty: the site currently has real READ content (topics via /explore/)
// but no real Guides or Videos yet. The envelope and clapperboard therefore
// show a single IN PROGRESS card — no fabricated directory.
//
// Shared "physical world": lighting direction, shadow logic, black outline,
// perspective, cursor sensitivity, inertia character, motion duration family,
// surface grain and saturation are all driven by the CSS vars below so the
// three stay coherent. No WebGL / canvas / 3D engine — CSS only.
//
// Attention budget: only the Newspaper (primary) carries a very weak idle
// motion. The Envelope and Clapperboard stay still until the cursor nears
// them (hover micro-reaction). Reduced motion disables idle + simplifies opens.

import type { Locale } from "../../lib/i18n.ts";
import { t } from "../../data/ui-strings.ts";

interface Props {
  locale: Locale;
  /** Where "READ" leads — the real content collection. */
  readUrl: string;
}

const { locale, readUrl } = Astro.props;
---

<section class="desk" data-desk-root aria-labelledby="desk-title">
  <header class="desk-head">
    <p class="desk-kicker">{t(locale, "desk.kicker")}</p>
    <h2 id="desk-title" class="desk-title">{t(locale, "desk.title")}</h2>
    <p class="desk-sub">{t(locale, "desk.sub")}</p>
  </header>

  <div class="desk-row">
    <!-- ── Newspaper · READ ── -->
    <article class="desk-item">
      <a
        class="desk-object desk-object--news"
        href={readUrl}
        data-desk-object="news"
        aria-label={t(locale, "desk.read.aria")}
      >
        <span class="news" aria-hidden="true">
          <span class="news-flap"></span>
          <span class="news-body">
            <span class="news-masthead">THE QUESTION</span>
            <span class="news-cols"></span>
            <span class="news-band"></span>
          </span>
        </span>
      </a>
      <div class="desk-caption">
        <span class="desk-verb">{t(locale, "desk.read.verb")}</span>
        <span class="desk-subtitle">{t(locale, "desk.read.subtitle")}</span>
      </div>
      <a class="desk-link" href={readUrl}>{t(locale, "desk.read.link")}</a>
    </article>

    <!-- ── Envelope · DO ── -->
    <article class="desk-item">
      <button
        class="desk-object desk-object--env"
        type="button"
        data-desk-object="env"
        aria-expanded="false"
        aria-label={t(locale, "desk.do.aria")}
      >
        <span class="env" aria-hidden="true">
          <span class="env-inside">{t(locale, "desk.do.inProgress")}</span>
          <span class="env-pocket"></span>
          <span class="env-flap"></span>
        </span>
      </button>
      <div class="desk-caption">
        <span class="desk-verb">{t(locale, "desk.do.verb")}</span>
        <span class="desk-subtitle">{t(locale, "desk.do.subtitle")}</span>
      </div>
      <p class="desk-note" data-desk-note="env">{t(locale, "desk.do.inProgress")}</p>
    </article>

    <!-- ── Clapperboard · WATCH ── -->
    <article class="desk-item">
      <button
        class="desk-object desk-object--clap"
        type="button"
        data-desk-object="clap"
        aria-pressed="false"
        aria-label={t(locale, "desk.watch.aria")}
      >
        <span class="clap" aria-hidden="true">
          <span class="clap-board">
            <span class="clap-stripes"></span>
            <span class="clap-text">SCENE · TAKE</span>
          </span>
          <span class="clap-arm"></span>
        </span>
      </button>
      <div class="desk-caption">
        <span class="desk-verb">{t(locale, "desk.watch.verb")}</span>
        <span class="desk-subtitle">{t(locale, "desk.watch.subtitle")}</span>
      </div>
      <p class="desk-note" data-desk-note="clap">{t(locale, "desk.watch.inProgress")}</p>
    </article>
  </div>
</section>

<style>
  .desk {
    /* ── One physical world ── */
    --obj-ink: #111216;
    --obj-shadow: 7px 8px 0 var(--obj-ink);
    --obj-line: 2.5px solid var(--obj-ink);
    --obj-dur: 240ms;
    --obj-clap-dur: 130ms;
    --obj-ease: cubic-bezier(0.22, 0.68, 0.32, 1);
    --obj-persp: 900px;
    --obj-tilt: 13deg;

    color: #fff;
    padding: clamp(2.2rem, 5vw, 3.6rem) clamp(1rem, 5vw, 5rem) clamp(3rem, 6vw, 5rem);
    border-top: 3px solid var(--obj-ink);
  }

  .desk-head {
    max-width: 52rem;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }
  .desk-kicker {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b8ef16;
  }
  .desk-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.05;
  }
  .desk-sub {
    margin: 0;
    max-width: 40rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 88%);
  }

  .desk-row {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.4rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .desk-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  /* ── Shared object frame ── */
  .desk-object {
    display: block;
    width: 100%;
    max-width: 15rem;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    perspective: var(--obj-persp);
    text-decoration: none;
    font: inherit;
    color: inherit;
  }
  .desk-object:focus-visible {
    outline: 3px solid #b8ef16;
    outline-offset: 6px;
    border-radius: 6px;
  }

  .desk-caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .desk-verb {
    font-size: 1.15rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }
  .desk-subtitle {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 82%);
  }
  .desk-link {
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1.5px;
  }
  .desk-link:hover,
  .desk-link:focus-visible {
    color: #b8ef16;
  }
  .desk-note {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #ffd91f;
    max-width: 15rem;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--obj-dur) var(--obj-ease),
      transform var(--obj-dur) var(--obj-ease);
  }
  .desk-note.is-revealed {
    opacity: 1;
    transform: none;
  }

  /* ════════════════ Newspaper · READ · UNFOLD ════════════════ */
  .news {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: #f4f0e6;
    border: var(--obj-line);
    box-shadow: var(--obj-shadow);
    overflow: hidden;
    transform-style: preserve-3d;
    transition: transform var(--obj-dur) var(--obj-ease);
  }
  .desk-object--news:hover .news,
  .desk-object--news:focus-visible .news {
    transform: translateY(-4px) rotateZ(-1.2deg);
  }
  .news-body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 0.7rem 0.6rem;
  }
  .news-masthead {
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(0.7rem, 2.4vw, 0.95rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--obj-ink);
    border-bottom: 2px solid var(--obj-ink);
    padding-bottom: 0.25rem;
    margin-bottom: 0.4rem;
    text-align: center;
  }
  .news-cols {
    flex: 1;
    background-image: repeating-linear-gradient(
      to bottom,
      #2a2a26 0 1.5px,
      transparent 1.5px 7px
    );
    opacity: 0.62;
    column-count: 2;
    column-gap: 0.5rem;
  }
  .news-band {
    height: 0.5rem;
    margin-top: 0.45rem;
    background: #ff5b42;
    border: 1.5px solid var(--obj-ink);
  }
  /* the folded-over top third; UNFOLD lifts it up to reveal the masthead */
  .news-flap {
    position: absolute;
    inset: 0 0 auto 0;
    height: 40%;
    background: linear-gradient(160deg, #efe9db, #e2d9c6);
    border-bottom: var(--obj-line);
    box-shadow: 0 6px 10px rgba(17, 18, 22, 0.22);
    transform-origin: top center;
    transform: rotateX(0deg);
    transition: transform var(--obj-dur) var(--obj-ease);
    backface-visibility: hidden;
  }
  .desk-object--news.is-unfold .news-flap {
    transform: rotateX(-152deg);
  }
  /* very weak idle life on the primary object only */
  .desk-object--news.is-idle .news {
    animation: news-sway 8s ease-in-out infinite;
  }
  @keyframes news-sway {
    0%, 100% { transform: rotateZ(-1deg); }
    50% { transform: rotateZ(1deg); }
  }

  /* ══════════════════ Envelope · DO · OPEN ══════════════════ */
  .env {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #ffd91f;
    border: var(--obj-line);
    box-shadow: var(--obj-shadow);
    overflow: hidden;
    transition: transform var(--obj-dur) var(--obj-ease);
  }
  .desk-object--env:hover .env,
  .desk-object--env:focus-visible .env {
    transform: translateY(-3px);
  }
  .env-inside {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 16%;
    padding: 0.55rem 0.5rem;
    background: #fff;
    border: 1.5px solid var(--obj-ink);
    font-size: 0.62rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: var(--obj-ink);
    opacity: 0;
    transition: opacity var(--obj-dur) var(--obj-ease);
  }
  .desk-object--env.is-open .env-inside {
    opacity: 1;
  }
  .env-pocket {
    position: absolute;
    inset: 30% 0 0 0;
    background: linear-gradient(180deg, #f3c612, #e6b800);
    border-top: var(--obj-line);
  }
  .env-flap {
    position: absolute;
    inset: 0 0 auto 0;
    height: 56%;
    background: linear-gradient(160deg, #ffe45e, #f3c612);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    border-bottom: var(--obj-line);
    transform-origin: top center;
    transform: rotateX(0deg);
    transition: transform var(--obj-dur) var(--obj-ease);
    backface-visibility: hidden;
    z-index: 2;
  }
  .desk-object--env:hover .env-flap {
    transform: rotateX(-20deg);
  }
  .desk-object--env.is-open .env-flap {
    transform: rotateX(-58deg);
  }

  /* ═════════════════ Clapperboard · WATCH · CLAP ═══════════════ */
  .clap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    transition: transform var(--obj-dur) var(--obj-ease);
  }
  .desk-object--clap:hover .clap,
  .desk-object--clap:focus-visible .clap {
    transform: translateY(-3px);
  }
  .clap-board {
    position: absolute;
    inset: 28% 6% 8% 6%;
    background: #f7f4ee;
    border: var(--obj-line);
    box-shadow: var(--obj-shadow);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .clap-stripes {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      45deg,
      #111216 0 6px,
      transparent 6px 14px
    );
    opacity: 0.16;
  }
  .clap-text {
    position: relative;
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(0.6rem, 2.2vw, 0.9rem);
    letter-spacing: 0.08em;
    color: var(--obj-ink);
  }
  .clap-arm {
    position: absolute;
    left: 4%;
    right: 4%;
    top: 4%;
    height: 30%;
    background: repeating-linear-gradient(
      45deg,
      #ff5b42 0 8px,
      #111216 8px 16px
    );
    border: var(--obj-line);
    box-shadow: var(--obj-shadow);
    transform-origin: top center;
    transform: rotateX(-14deg);
    transition: transform var(--obj-clap-dur) var(--obj-ease);
    z-index: 3;
  }
  .desk-object--clap:hover .clap-arm {
    transform: rotateX(-26deg);
  }
  .desk-object--clap.is-clapped .clap-arm {
    transform: rotateX(0deg);
  }

  /* ── Mobile: objects become bounded, stacked, non-intrusive ── */
  @media (max-width: 47.99rem) {
    .desk-row {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 26rem;
    }
    .desk-object {
      max-width: 13rem;
    }
  }

  /* ── Reduced motion: no idle, opens become near-instant, nav intact ── */
  @media (prefers-reduced-motion: reduce) {
    .desk-object--news.is-idle .news {
      animation: none;
    }
    .news,
    .news-flap,
    .env,
    .env-flap,
    .env-inside,
    .clap,
    .clap-arm,
    .desk-note {
      transition-duration: 0.01ms !important;
    }
    .news-sway {
      animation: none !important;
    }
  }
</style>

<script>
  function initDesk(root: HTMLElement) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── Newspaper · UNFOLD then enter the READ collection ──
    const news = root.querySelector<HTMLAnchorElement>('[data-desk-object="news"]');
    if (news) {
      news.addEventListener("click", (e) => {
        if (reduce) return; // let the link navigate immediately
        e.preventDefault();
        news.classList.add("is-unfold");
        const href = news.getAttribute("href") || "/explore/";
        window.setTimeout(() => {
          window.location.href = href;
        }, 380);
      });
      // gentle idle life on the primary object
      if (!reduce) news.classList.add("is-idle");
    }

    // ── Envelope · OPEN (honest prototype — no navigation) ──
    const env = root.querySelector<HTMLButtonElement>('[data-desk-object="env"]');
    const envNote = root.querySelector<HTMLElement>('[data-desk-note="env"]');
    if (env) {
      env.addEventListener("click", () => {
        const open = env.classList.toggle("is-open");
        env.setAttribute("aria-expanded", open ? "true" : "false");
        if (open && envNote) envNote.classList.add("is-revealed");
      });
    }

    // ── Clapperboard · CLAP (honest prototype — no navigation) ──
    const clap = root.querySelector<HTMLButtonElement>('[data-desk-object="clap"]');
    const clapNote = root.querySelector<HTMLElement>('[data-desk-note="clap"]');
    if (clap) {
      clap.addEventListener("click", () => {
        const pressed = clap.getAttribute("aria-pressed") === "true";
        clap.setAttribute("aria-pressed", pressed ? "false" : "true");
        if (clapNote) clapNote.classList.add("is-revealed");
        if (reduce) return;
        clap.classList.add("is-clapped");
        window.setTimeout(() => clap.classList.remove("is-clapped"), 200);
      });
    }
  }

  document.querySelectorAll<HTMLElement>("[data-desk-root]").forEach(initDesk);
</script>
