---
import type { SiteTopic } from "../../data/topics.ts";
import type { Locale } from "../../lib/i18n.ts";
import { t } from "../../data/ui-strings.ts";
import LivingEvidenceObject from "../experiences/LivingEvidenceObject.astro";
import PlayableDesk from "./PlayableDesk.astro";

interface Props {
  // The Topic featured on the cover, resolved by the page from explicit
  // config (homeCoverTopicId in src/data/site.ts) via stable topicId.
  // Never derived from array position. Undefined renders no cover.
  coverTopic?: SiteTopic;
  locale: Locale;
  // Explicit override for the cover button target. The page sets this when
  // the cover Topic exists as data but has no released page in the current
  // build mode (e.g. a draft translation in a public build), so the button
  // never links to a page that was not built.
  coverHref?: string;
}

const { coverTopic, locale, coverHref } = Astro.props;
const hrefPrefix = locale === "zh" ? "/zh" : "";

const topicUrl = coverHref
  ?? (coverTopic
    ? `${hrefPrefix}/topics/${coverTopic.slug}/`
    : `${hrefPrefix}/explore/`);
const exploreUrl = `${hrefPrefix}/explore/`;

const coverConfig = coverTopic
  ? {
      kicker: t(locale, "home.typeCaseLabel"),
      title: coverTopic.category,
      statement: coverTopic.openingQuestion,
      objectLabel: `${t(locale, "home.typeCaseLabel")}: ${coverTopic.category}. ${coverTopic.openingQuestion}`,
      hint: t(locale, "home.coverHint"),
      hotspots: [
        {
          x: 56,
          y: 54,
          label: t(locale, "home.block.question.label"),
          detail: coverTopic.deck,
        },
      ],
    }
  : null;
---

<section class="question-space" aria-labelledby="question-space-title">
  <div class="question-space__grid">
    <div class="question-space__copy">
      <p class="question-label">
        <span>{t(locale, "home.block.question.label")}</span>
        <span aria-hidden="true"> / 01</span>
      </p>
      <p class="question-space__eyebrow">{t(locale, "home.eyebrow")}</p>
      <h1 id="question-space-title">
        {t(locale, "home.titleLine1")}<br />{t(locale, "home.titleLine2")}
      </h1>
      <p class="question-space__deck">{t(locale, "home.deck")}</p>
      <p class="question-space__method">
        {t(locale, "home.method")}
      </p>

      <div class="question-space__entry">
        <a class="entry-button" href={topicUrl}>
          {t(locale, "home.openTopic")}
        </a>
        <a class="entry-link" href={exploreUrl}>
          {t(locale, "home.route.exploreAll")}
        </a>
      </div>
    </div>

    <div class="cover-stage" aria-label={t(locale, "home.typeCaseLabel")}>
      {coverConfig && <LivingEvidenceObject config={coverConfig} locale={locale} />}
    </div>
  </div>

  <PlayableDesk locale={locale} readUrl={exploreUrl} />
</section>

<style>
  .question-space {
    background:
      linear-gradient(135deg, rgb(255 255 255 / 8%) 0 1px, transparent 1px 100%) 0 0 / 2.2rem 2.2rem,
      #063bc9;
    color: #fff;
  }

  .question-space__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    min-height: auto;
    padding: clamp(2.2rem, 5vw, 4rem) clamp(1rem, 5vw, 5rem);
  }

  .question-space__copy {
    position: relative;
    z-index: 3;
    align-self: center;
    min-width: 0;
  }

  .question-label {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin: 0 0 0.9rem;
    padding: 0.35rem 0.6rem;
    border: 2px solid #111216;
    background: #ffd91f;
    color: #111216;
    font-size: 0.66rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    transform: rotate(-1.5deg);
    transform-origin: left center;
    box-shadow: 3px 3px 0 #111216;
  }

  .question-space__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 950;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 9.5ch;
    margin: 0;
    font-size: clamp(3.6rem, 12vw, 8rem);
    line-height: 0.82;
    letter-spacing: -0.052em;
  }

  /* Chinese glyphs are wider than a latin `ch`; give the zh headline room
     so "真假中国：迷思与现实。" breaks into two clean lines. */
  :lang(zh) h1 {
    max-width: 14ch;
  }

  .question-space__deck {
    max-width: 34rem;
    margin: 1.5rem 0;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.5;
  }

  .question-space__method {
    max-width: 35rem;
    margin: 0;
    padding-block: 0.85rem;
    border-block: 1.5px solid rgb(255 255 255 / 75%);
    font-size: 0.7rem;
    font-weight: 950;
    letter-spacing: 0.06em;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .question-space__entry {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-top: 1.6rem;
  }

  .entry-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border: 2px solid #111216;
    background: #111216;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 950;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 4px 4px 0 #ffd91f;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .entry-button:hover,
  .entry-button:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 #ffd91f;
  }

  .entry-link {
    color: #fff;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1.5px;
  }

  .entry-link:hover,
  .entry-link:focus-visible {
    color: #b8ef16;
  }

  .cover-stage {
    position: relative;
    align-self: center;
    min-width: 0;
    border: 3px solid #111216;
    background: #d7dce3;
    box-shadow: 12px 14px 0 #111216;
    color: #111216;
  }

  @media (min-width: 48rem) {
    .question-space__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(24rem, 1fr);
      align-items: center;
    }

    h1 {
      font-size: clamp(4.2rem, 6.8vw, 7rem);
    }
  }

  @media (min-width: 80rem) {
    .question-space__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(26rem, 1fr);
      gap: clamp(4rem, 7vw, 8rem);
    }
  }

  @media (max-width: 47.99rem) {
    .question-space__grid {
      min-height: auto;
      padding-bottom: 3rem;
    }

    .cover-stage {
      max-width: 28rem;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .question-space__grid {
      min-height: auto;
    }

    .entry-button,
    .entry-link {
      transition: none;
    }
  }
</style>
