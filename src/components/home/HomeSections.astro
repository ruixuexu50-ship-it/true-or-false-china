---
// HomeSections — everything below the hero, as one browsing path:
//   02 Currently investigating  (paper, quiet, one real question)
//   03 The five libraries       (white, structured entry grid)
//   04 Method & trust           (paper, statement + steps)
//   05 Read next                (soft gray, real topic cards)
//   06 Community                (white, small and quiet)
//
// Rhythm comes from background changes, whitespace, and type scale —
// not from stacking rounded cards. All numbers shown are real data
// (dates, states) taken from the Topic records; nothing is invented.

import { getLibraries, LIBRARY_ICONS } from "../../data/libraries.ts";
import { t } from "../../data/ui-strings.ts";
import type { Locale } from "../../lib/i18n.ts";
import type { SiteTopic } from "../../data/topics.ts";
import ResearchDesk from "./ResearchDesk.astro";

interface Props {
  locale: Locale;
  /** The Topic currently being investigated (explicit config upstream). */
  investigateTopic: SiteTopic | undefined;
  /** Where "open the investigation" leads — always a built page. */
  investigateHref: string;
  /** Topic pages the current build mode actually emits. */
  releasedTopics: SiteTopic[];
}

const { locale, investigateTopic, investigateHref, releasedTopics } = Astro.props;

const libraries = getLibraries(locale);
const methodSteps = [
  { label: t(locale, "method.step.q.label"), text: t(locale, "method.step.q.text") },
  { label: t(locale, "method.step.e.label"), text: t(locale, "method.step.e.text") },
  { label: t(locale, "method.step.m.label"), text: t(locale, "method.step.m.text") },
  { label: t(locale, "method.step.b.label"), text: t(locale, "method.step.b.text") },
  { label: t(locale, "method.step.i.label"), text: t(locale, "method.step.i.text") },
];
const trustPoints = [
  t(locale, "method.trust.1"),
  t(locale, "method.trust.2"),
  t(locale, "method.trust.3"),
  t(locale, "method.trust.4"),
];

const stateLabel = (topic: SiteTopic) =>
  topic.releaseState === "draft"
    ? t(locale, "now.state.draft")
    : t(locale, "now.state.working");

const topicUrl = (topic: SiteTopic) =>
  `${locale === "zh" ? "/zh" : ""}/topics/${topic.slug}/`;
---

<div class="home-flow">
<!-- 02 · Currently investigating -->
{
  investigateTopic && (
    <section class="now" aria-labelledby="now-title">
      <span class="section-ghost" aria-hidden="true">02</span>
      <div class="now__inner">
        <div class="now__copy">
          <p class="section-kicker">{t(locale, "now.kicker")}</p>
          <h2 id="now-title" class="now__question">
            {investigateTopic.openingQuestion}
          </h2>
          <p class="now__deck">{investigateTopic.deck}</p>
          <a class="text-link" href={investigateHref}>
            {t(locale, "now.open")}
          </a>
        </div>
        <dl class="now__label-card">
          <div class="now__label-head">
            <dt>{t(locale, "now.cardLabel")}</dt>
            <dd class:list={["now__state", { "now__state--draft": investigateTopic.releaseState === "draft" }]}>
              {stateLabel(investigateTopic)}
            </dd>
          </div>
          <div>
            <dt>{t(locale, "now.category")}</dt>
            <dd>{investigateTopic.category}</dd>
          </div>
          <div>
            <dt>{t(locale, "now.lastReviewed")}</dt>
            <dd>{investigateTopic.lastReviewed}</dd>
          </div>
        </dl>
      </div>
    </section>
  )
}

<!-- 03 · Three ways in -->
<ResearchDesk locale={locale} />

<!-- 04 · The five libraries -->
<section class="libs" aria-labelledby="libs-title">
  <span class="section-ghost" aria-hidden="true">04</span>
  <div class="libs__inner">
    <header class="libs__head">
      <p class="section-kicker">{t(locale, "lib.kicker")}</p>
      <h2 id="libs-title" class="libs__title">{t(locale, "lib.title")}</h2>
      <p class="libs__sub">{t(locale, "lib.sub")}</p>
    </header>
    <ul class="libs__grid">
      {libraries.map((entry) => (
        <li class="lib-entry">
          {entry.href ? (
            <a
              class="lib-entry__link"
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noopener noreferrer" : undefined}
            >
              <span
                class={`lib-entry__icon lib-entry__icon--${entry.icon}`}
                set:html={LIBRARY_ICONS[entry.icon]}
                aria-hidden="true"
              />
              <span class="lib-entry__name">{entry.label}</span>
              <span class="lib-entry__desc">{entry.desc}</span>
              <span class="lib-entry__go">
                {entry.external ? "↗" : "→"}
              </span>
            </a>
          ) : (
            <div class="lib-entry__link lib-entry__link--soon" aria-disabled="true">
              <span
                class={`lib-entry__icon lib-entry__icon--${entry.icon}`}
                set:html={LIBRARY_ICONS[entry.icon]}
                aria-hidden="true"
              />
              <span class="lib-entry__name">{entry.label}</span>
              <span class="lib-entry__desc">{entry.desc}</span>
              <span class="lib-entry__go lib-entry__go--soon">
                {t(locale, "cabinet.comingSoon")}
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 05 · Method & trust -->
<section class="method" id="how-this-works" aria-labelledby="method-title">
  <span class="section-ghost" aria-hidden="true">05</span>
  <div class="method__inner">
    <div class="method__statement">
      <p class="section-kicker">{t(locale, "method.kicker")}</p>
      <h2 id="method-title" class="method__title">{t(locale, "method.title")}</h2>
    </div>
    <div class="method__columns">
      <ol class="method__steps">
        {methodSteps.map((step, index) => (
          <li class="method__step">
            <span class="method__step-no">{String(index + 1).padStart(2, "0")}</span>
            <span class="method__step-body">
              <strong>{step.label}</strong>
              {step.text}
            </span>
          </li>
        ))}
      </ol>
      <aside class="method__trust">
        <h3>{t(locale, "method.trust.title")}</h3>
        <ul>
          {trustPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<!-- 06 · Read next -->
<section class="featured" aria-labelledby="featured-title">
  <span class="section-ghost" aria-hidden="true">06</span>
  <div class="featured__inner">
    <header class="featured__head">
      <p class="section-kicker">{t(locale, "featured.kicker")}</p>
      <h2 id="featured-title" class="featured__title">{t(locale, "featured.title")}</h2>
    </header>
    {releasedTopics.length > 0 ? (
      <ul class="featured__grid">
        {releasedTopics.map((topic) => (
          <li>
            <a class="topic-card" href={topicUrl(topic)}>
              <span class="topic-card__eyebrow">{topic.category}</span>
              <span class="topic-card__question">{topic.openingQuestion}</span>
              <span class="topic-card__deck">{topic.deck}</span>
              <span class="topic-card__meta">
                {stateLabel(topic)} · {topic.lastReviewed}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="featured__pending">
        {t(locale, "featured.zhPending")}
        <a class="text-link" href="/explore/">Topics ↗</a>
      </p>
    )}
  </div>
</section>

<!-- 07 · Community -->
<section class="community" aria-labelledby="community-title">
  <span class="section-ghost" aria-hidden="true">07</span>
  <div class="community__inner">
    <p class="section-kicker">{t(locale, "community.kicker")}</p>
    <h2 id="community-title" class="community__title">{t(locale, "community.title")}</h2>
    <p class="community__body">{t(locale, "community.body")}</p>
    <ul class="community__links">
      {libraries
        .filter((entry) => entry.external)
        .map((entry) => (
          <li>
            {entry.href ? (
              <a class="community-card" href={entry.href} target="_blank" rel="noopener noreferrer">
                <span class={`community-card__icon community-card__icon--${entry.icon}`} set:html={LIBRARY_ICONS[entry.icon]} aria-hidden="true" />
                <span class="community-card__name">{entry.label}</span>
                <span class="community-card__desc">{entry.desc}</span>
                <span class="community-card__tag">↗</span>
              </a>
            ) : (
              <div class="community-card community-card--soon" aria-disabled="true">
                <span class={`community-card__icon community-card__icon--${entry.icon}`} set:html={LIBRARY_ICONS[entry.icon]} aria-hidden="true" />
                <span class="community-card__name">{entry.label}</span>
                <span class="community-card__desc">{entry.desc}</span>
                <span class="community-card__tag community-card__tag--soon">
                  {t(locale, "cabinet.comingSoon")}
                </span>
              </div>
            )}
          </li>
        ))}
    </ul>
  </div>
</section>
</div>

<style>
  /* One continuous cobalt stage — hero flows straight into the
     sections; objects are light panels on top of it. */
  .home-flow {
    background:
      radial-gradient(60rem 34rem at 88% 4%, rgb(255 255 255 / 8%), transparent 60%),
      var(--cobalt);
  }
  /* Oversized ghost section indices — graphic rhythm, not content. */
  .now,
  .libs,
  .method,
  .featured,
  .community {
    position: relative;
    overflow: hidden;
  }
  .section-ghost {
    position: absolute;
    top: 0.6rem;
    right: clamp(0.8rem, 4vw, 3rem);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 10vw, 8.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgb(255 255 255 / 7%);
    pointer-events: none;
    user-select: none;
  }

  .section-kicker {
    margin: 0 0 0.8rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--obj-yellow);
  }

  .text-link {
    display: inline-block;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.28em;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(255 196 0 / 60%);
  }
  .text-link:hover,
  .text-link:focus-visible {
    color: var(--obj-yellow);
  }

  /* ── 02 · Currently investigating ── */
  .now {
    background: transparent;
  }
  .now__inner {
    display: grid;
    gap: clamp(1.8rem, 4vw, 3.5rem);
    width: min(66rem, 100%);
    margin-inline: auto;
    padding: clamp(2.8rem, 6vw, 4.5rem) clamp(1.2rem, 4vw, 3rem);
  }
  .now__question {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.015em;
    color: #fff;
  }
  :lang(zh) .now__question {
    max-width: 22ch;
  }
  .now__deck {
    max-width: 36rem;
    margin: 1rem 0 1.4rem;
    font-size: 1rem;
    line-height: 1.65;
    color: rgb(242 244 248 / 80%);
  }
  /* Research-file card — same object language as the cabinet. */
  .now__label-card {
    align-self: start;
    display: grid;
    gap: 0;
    margin: 0;
    background: var(--obj-panel);
    border: var(--obj-line);
    border-radius: 6px;
    box-shadow: var(--obj-shadow);
    font-size: 0.82rem;
    overflow: hidden;
  }
  .now__label-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.6rem 1rem;
    background: var(--obj-black);
    color: #fff;
  }
  .now__label-head dt {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .now__state {
    margin: 0;
    padding: 0.2rem 0.55rem;
    background: var(--cobalt);
    border-radius: 999px;
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .now__state--draft {
    background: rgb(255 255 255 / 18%);
  }
  .now__label-card > div:not(.now__label-head) {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.8rem;
    padding: 0.7rem 1rem;
  }
  .now__label-card > div + div:not(.now__label-head) {
    border-top: 1px solid var(--line-soft);
  }
  .now__label-card dt {
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }
  .now__label-card dd {
    margin: 0;
    font-weight: 650;
  }
  @media (min-width: 56rem) {
    .now__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.9fr);
      align-items: start;
    }
  }

  /* ── 04 · Five libraries ── */
  .libs {
    background: transparent;
  }
  .libs__inner {
    width: min(72rem, 100%);
    margin-inline: auto;
    padding: clamp(2.8rem, 6vw, 4.5rem) clamp(1.2rem, 4vw, 3rem);
  }
  .libs__head {
    max-width: 44rem;
    margin-bottom: clamp(1.6rem, 3.5vw, 2.4rem);
  }
  .libs__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .libs__sub {
    margin: 0.7rem 0 0;
    font-size: 0.94rem;
    line-height: 1.6;
    color: rgb(242 244 248 / 72%);
  }
  .libs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: clamp(0.9rem, 2vw, 1.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lib-entry {
    list-style: none;
  }
  .lib-entry__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.2rem 1.1rem 2.3rem;
    background: var(--obj-panel);
    border: var(--obj-line-thin);
    border-radius: 5px;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 5px 6px 0 rgb(5 10 40 / 30%);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .lib-entry__link:hover,
  .lib-entry__link:focus-visible {
    transform: translateY(-3px);
    box-shadow: 8px 10px 0 rgb(5 10 40 / 42%);
    z-index: 2;
  }
  .lib-entry__link:focus-visible {
    outline: 3px solid var(--obj-yellow);
    outline-offset: 2px;
  }
  .lib-entry__link--soon {
    border-style: dashed;
  }
  .lib-entry__link--soon:hover {
    transform: none;
    box-shadow: 5px 6px 0 rgb(5 10 40 / 30%);
  }
  .lib-entry__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 8px;
  }
  .lib-entry__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .lib-entry__name {
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }
  .lib-entry__desc {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .lib-entry__go {
    position: absolute;
    right: 1.1rem;
    bottom: 0.9rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--cobalt);
  }
  .lib-entry__go--soon {
    color: var(--coral);
  }

  /* Icon chips: one color family, distinct tints per library. */
  .lib-entry__icon--topics { color: var(--cobalt); background: rgb(13 59 255 / 10%); }
  .lib-entry__icon--scripts { color: var(--coral); background: rgb(255 107 107 / 12%); }
  .lib-entry__icon--checklists { color: var(--navy-2); background: rgb(27 39 66 / 10%); }
  .lib-entry__icon--discord { color: rgb(75 78 88 / 60%); background: rgb(75 78 88 / 10%); }
  .lib-entry__icon--tiktok { color: rgb(75 78 88 / 60%); background: rgb(75 78 88 / 10%); }

  /* ── 05 · Method & trust ── */
  .method {
    background: transparent;
  }
  .method__inner {
    width: min(66rem, 100%);
    margin-inline: auto;
    padding: clamp(2.8rem, 6vw, 4.5rem) clamp(1.2rem, 4vw, 3rem);
  }
  .method__title {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .method__columns {
    display: grid;
    gap: clamp(1.8rem, 4vw, 3.5rem);
    margin-top: clamp(1.6rem, 3.5vw, 2.4rem);
  }
  @media (min-width: 56rem) {
    .method__columns {
      grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.85fr);
    }
  }
  .method__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .method__step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-top: 1px solid rgb(255 255 255 / 22%);
  }
  .method__step:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 22%);
  }
  .method__step-no {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--obj-yellow);
    padding-top: 0.2rem;
  }
  .method__step-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.7rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(242 244 248 / 78%);
  }
  .method__step-body strong {
    color: #fff;
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .method__trust {
    align-self: start;
    padding: 1.2rem 1.3rem;
    background: var(--obj-panel);
    border: var(--obj-line-thin);
    border-left: 4px solid var(--obj-yellow);
    border-radius: 5px;
    box-shadow: 5px 6px 0 rgb(5 10 40 / 30%);
  }
  .method__trust h3 {
    margin: 0 0 0.7rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .method__trust ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .method__trust li {
    padding-left: 1.1rem;
    position: relative;
  }
  .method__trust li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--cobalt);
    font-weight: 900;
  }

  /* ── 06 · Read next ── */
  .featured {
    background: transparent;
  }
  .featured__inner {
    width: min(66rem, 100%);
    margin-inline: auto;
    padding: clamp(2.8rem, 6vw, 4.5rem) clamp(1.2rem, 4vw, 3rem);
  }
  .featured__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #fff;
  }
  .featured__grid {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.6rem);
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .featured__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .topic-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    padding: 1.6rem 1.5rem 1.4rem;
    background: var(--obj-panel);
    border: var(--obj-line-thin);
    border-top: 4px solid var(--obj-yellow);
    border-radius: 5px;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 5px 6px 0 rgb(5 10 40 / 30%);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .topic-card:hover,
  .topic-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 8px 10px 0 rgb(5 10 40 / 42%);
  }
  .topic-card:focus-visible {
    outline: 3px solid var(--obj-yellow);
    outline-offset: 2px;
  }
  .topic-card__eyebrow {
    align-self: flex-start;
    padding: 0.18rem 0.55rem;
    background: rgb(13 59 255 / 9%);
    border: 1px solid rgb(13 59 255 / 35%);
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cobalt);
  }
  .topic-card__question {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .topic-card__deck {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .topic-card__meta {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-top: 1px solid var(--line-soft);
  }
  .featured__pending {
    margin: 1.4rem 0 0;
    max-width: 34rem;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgb(242 244 248 / 78%);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    align-items: baseline;
  }

  /* ── 07 · Community ── */
  .community {
    background: transparent;
  }
  .community__inner {
    width: min(66rem, 100%);
    margin-inline: auto;
    padding: clamp(2.4rem, 5vw, 3.6rem) clamp(1.2rem, 4vw, 3rem);
  }
  .community__title {
    margin: 0;
    font-family: var(--font-display);
