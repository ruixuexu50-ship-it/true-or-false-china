---
interface Props {
  visible: boolean;
}

const { visible } = Astro.props;
---

{
  visible && (
    <aside class="review-badge" role="status">
      Local review · not approved for publication
    </aside>
  )
}

<style>
  .review-badge {
    position: relative;
    z-index: 10;
    padding: 0.55rem 1rem;
    background: #121522;
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }
</style>
