---
import LocalReviewBadge from "../components/LocalReviewBadge.astro";
import OwnerReviewDrawer from "../components/OwnerReviewDrawer.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { externalLinks, siteIdentity } from "../data/site.ts";
import { isPublicRelease } from "../data/release.ts";
import { t } from "../data/ui-strings.ts";
import { switchLocalePath } from "../lib/i18n.ts";
import type { OwnerReviewKey } from "../data/owner-review.ts";
import type { Locale } from "../lib/i18n.ts";
// Global design tokens (colors, type families, border, shadow).
// Brand-level visual changes happen in that one file.
import "../styles/tokens.css";

interface Props {
  title: string;
  description: string;
  robots?: "noindex,nofollow" | "index,follow";
  showLocalReviewIndicator?: boolean;
  ownerReviewKey?: OwnerReviewKey;
  bodyClass?: string;
  locale?: Locale;
}

const {
  title,
  description,
  robots = "noindex,nofollow",
  showLocalReviewIndicator = true,
  ownerReviewKey,
  bodyClass = "",
  locale = "en",
} = Astro.props;

const pathname = Astro.url.pathname;
const prefix = locale === "zh" ? "/zh" : "";
const homeHref = `${prefix}/`;
const exploreHref = `${prefix}/explore/`;
const transcriptsHref = `${prefix}/transcripts/`;
const checklistsHref = `${prefix}/checklists/`;
const enAlt = switchLocalePath(pathname, "en");
const zhAlt = switchLocalePath(pathname, "zh");
---

<!doctype html>
<html lang={locale === "zh" ? "zh" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f1729" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
    <link rel="alternate" hreflang="en" href={enAlt} />
    <link rel="alternate" hreflang="zh" href={zhAlt} />
    <link rel="alternate" hreflang="x-default" href={enAlt} />
    <title>{title} · {siteIdentity.name}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{t(locale, "skipLink")}</a>
    <LocalReviewBadge visible={showLocalReviewIndicator} />
    {
      showLocalReviewIndicator && ownerReviewKey && (
        <OwnerReviewDrawer reviewKey={ownerReviewKey} />
      )
    }
    <header class="site-header">
      <a class="wordmark" href={homeHref} aria-label={`${siteIdentity.name} ${t(locale, "lang.switchTo").replace("{name}", t(locale, "lang.en"))}`}>
        <span>T/F</span>
        <span>{siteIdentity.name}</span>
      </a>
      <nav aria-label="Primary">
        <a href={exploreHref}>{t(locale, "nav.topics")}</a>
        <a class="nav-lib" href={transcriptsHref}>{t(locale, "nav.transcripts")}</a>
        <a class="nav-lib" href={checklistsHref}>{t(locale, "nav.checklists")}</a>
        {externalLinks.discordUrl && (
          <a class="nav-external" href={externalLinks.discordUrl} target="_blank" rel="noopener noreferrer">
            Discord <span aria-hidden="true">↗</span>
          </a>
        )}
        {externalLinks.tiktokUrl && (
          <a class="nav-external" href={externalLinks.tiktokUrl} target="_blank" rel="noopener noreferrer">
            TikTok <span aria-hidden="true">↗</span>
          </a>
        )}
        <LanguageSwitcher locale={locale} />
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(locale, "footer.line1")}</p>
      <p>{isPublicRelease ? t(locale, "footer.line2Public") : t(locale, "footer.line2")}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: var(--font-body);
    font-synthesis: none;
    background: var(--paper);
    color: var(--ink);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 20rem;
    overflow-x: hidden;
    background: var(--paper);
    color: var(--ink);
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.5rem;
    left: 0.5rem;
    transform: translateY(-180%);
    padding: 0.7rem 0.9rem;
    border: var(--line);
    background: var(--yellow);
    font-weight: 900;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.2rem;
    padding: 0.85rem clamp(1rem, 4vw, 3.5rem);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    background: rgb(15 23 41 / 94%);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .wordmark {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    color: #fff;
  }

  .wordmark span:first-child {
    padding: 0.32rem 0.42rem;
    background: var(--cobalt);
    color: #fff;
    border-radius: 3px;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.4vw, 1.7rem);
  }

  .site-header nav > a {
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: rgb(242 244 248 / 72%);
    white-space: nowrap;
  }

  .site-header nav > a:hover,
  .site-header nav > a:focus-visible {
    color: #fff;
  }

  main {
    width: 100%;
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: pretty;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .site-footer {
    display: grid;
    gap: 0.5rem;
    padding: 2rem clamp(1rem, 4vw, 3.5rem);
    border-top: 2px solid var(--navy);
    background: var(--navy);
    color: rgb(242 244 248 / 88%);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }

  .site-footer p {
    margin: 0;
  }

  :focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }

  @media (min-width: 48rem) {
    .site-footer {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  /* Library nav entries fold away on narrow screens; the homepage
     still shows all five entries in full. */
  @media (max-width: 59.99rem) {
    .nav-lib {
      display: none;
    }
  }

  @media (max-width: 39.99rem) {
    .nav-external {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
