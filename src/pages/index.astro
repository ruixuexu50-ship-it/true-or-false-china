---
import HomeHero from "../components/home/HomeHero.astro";
import HomeSections from "../components/home/HomeSections.astro";
import { getReleasePlan, isPublicRelease } from "../data/release.ts";
import { homeCoverTopicId, siteDescription } from "../data/site.ts";
import { getTopicById, getTopicsByLocale } from "../data/topics.ts";
import SiteLayout from "../layouts/SiteLayout.astro";

// The cover / "currently investigating" Topic comes from explicit
// editorial config, keyed by stable topicId — never from array position.
const coverTopic = getTopicById(homeCoverTopicId, "en");

// Only Topic pages the current build mode actually emits may be
// linked from the homepage.
const releasedSlugs = getReleasePlan("en").pages.map((page) => page.slug);
const releasedTopics = getTopicsByLocale("en").filter((topic) =>
  releasedSlugs.includes(topic.slug),
);

const investigateHref =
  coverTopic && releasedSlugs.includes(coverTopic.slug)
    ? `/topics/${coverTopic.slug}/`
    : "/explore/";

// Real meta for the hero line: latest review date across released Topics.
const latestReviewDate =
  releasedTopics.length > 0
    ? releasedTopics
        .map((topic) => topic.lastReviewed)
        .sort()
        .at(-1) ?? null
    : null;
---

<SiteLayout
  title="True or False China"
  description={siteDescription}
  robots={isPublicRelease ? "index,follow" : "noindex,nofollow"}
  showLocalReviewIndicator={!isPublicRelease}
  ownerReviewKey="home"
  bodyClass="home-page"
  locale="en"
>
  <HomeHero
    locale="en"
    releasedCount={releasedTopics.length}
    latestReviewDate={latestReviewDate}
  />
  <HomeSections
    locale="en"
    investigateTopic={coverTopic}
    investigateHref={investigateHref}
    releasedTopics={releasedTopics}
  />
</SiteLayout>
