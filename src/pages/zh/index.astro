---
import HomeHero from "../../components/home/HomeHero.astro";
import HomeSections from "../../components/home/HomeSections.astro";
import { getReleasePlan, isPublicRelease } from "../../data/release.ts";
import { homeCoverTopicId } from "../../data/site.ts";
import { getTopicById, getTopicsByLocale } from "../../data/topics.ts";
import { t } from "../../data/ui-strings.ts";
import SiteLayout from "../../layouts/SiteLayout.astro";

// Same explicit-config resolution as the English homepage; the zh
// Topic records are drafts, so in a public build the released list
// is empty and the homepage falls back to honest states instead of
// linking pages that were not built.
const coverTopic = getTopicById(homeCoverTopicId, "zh");

const releasedSlugs = getReleasePlan("zh").pages.map((page) => page.slug);
const releasedTopics = getTopicsByLocale("zh").filter((topic) =>
  releasedSlugs.includes(topic.slug),
);

const investigateHref =
  coverTopic && releasedSlugs.includes(coverTopic.slug)
    ? `/zh/topics/${coverTopic.slug}/`
    : "/zh/explore/";

const latestReviewDate =
  releasedTopics.length > 0
    ? releasedTopics
        .map((topic) => topic.lastReviewed)
        .sort()
        .at(-1) ?? null
    : null;

const description = t("zh", "home.deck");
---

<SiteLayout
  title={`${t("zh", "home.headline")}`}
  description={description}
  robots={isPublicRelease ? "index,follow" : "noindex,nofollow"}
  showLocalReviewIndicator={!isPublicRelease}
  ownerReviewKey="home"
  bodyClass="home-page"
  locale="zh"
>
  <HomeHero
    locale="zh"
    releasedCount={releasedTopics.length}
    latestReviewDate={latestReviewDate}
  />
  <HomeSections
    locale="zh"
    investigateTopic={coverTopic}
    investigateHref={investigateHref}
    releasedTopics={releasedTopics}
  />
</SiteLayout>
